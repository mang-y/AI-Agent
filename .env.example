# ============================================================
# AI Agent 项目环境变量配置
# ============================================================
# 使用方法：复制本文件为 .env 并填入实际值
#   cp .env.example .env

# --- DashScope (通义千问) ---
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# --- LangSmith 可观测性 ---
# 获取地址：https://smith.langchain.com/
# 开启后，所有 LLM 调用、工具调用、LangGraph 节点执行都会被自动追踪
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=sk-your-dashscope-api-key-here
LANGSMITH_PROJECT=rag-agent-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Qdrant 向量库 ---
# 本地模式：使用 persist_directory 持久化（默认）
# 服务模式：设置以下变量并修改 rag_infra.py 中的初始化逻辑
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Redis (历史记录，可选) ---
# 不配置时自动降级为文件存储
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-password
